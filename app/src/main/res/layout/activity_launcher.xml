<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111216"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tagline"
            android:textColor="#9AA0AA"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#C8CCD4"
            android:textSize="15sp" />

        <!-- The main button: Wrecked Metal, the customized game -->
        <Button
            android:id="@+id/play"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#D9481C"
            android:letterSpacing="0.08"
            android:text="@string/play"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Discreet: the game as the N64 had it -->
            <Button
                android:id="@+id/play_fidelity"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/play_fidelity"
                android:textAllCaps="false"
                android:textColor="#C8CCD4"
                android:textSize="15sp" />

            <Button
                android:id="@+id/pick_rom"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/pick_rom"
                android:textAllCaps="false"
                android:textColor="#8A909C"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fidelity_hint"
            android:textColor="#6F7580"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/touch_title"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/touch_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/touch_enabled"
            android:textColor="#C8CCD4" />

        <CheckBox
            android:id="@+id/touch_arrows"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/touch_arrows"
            android:textColor="#C8CCD4" />

        <CheckBox
            android:id="@+id/touch_hide_with_gamepad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/touch_hide_with_gamepad"
            android:textColor="#C8CCD4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/touch_opacity"
            android:textColor="#C8CCD4" />

        <SeekBar
            android:id="@+id/touch_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/touch_scale"
            android:textColor="#C8CCD4" />

        <SeekBar
            android:id="@+id/touch_scale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/data_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#8A909C"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
